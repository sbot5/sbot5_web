# ── 必须配置 ────────────────────────────────────────────────

# PostgreSQL 连接字符串
DATABASE_URL=postgres://username:password@localhost:5432/blog_db

# JWT 签名密钥（≥32 字节随机字符串）
# 生成: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key

# ── 安全 ────────────────────────────────────────────────────

# 注册邀请码（不设置则关闭注册功能）
REGISTER_CODE=my-secret-invite-code

# CORS 允许的源（多个用逗号分隔）
# 阿里云部署时改为你的前端域名
CORS_ORIGIN=http://localhost:5173

# ── 功能 ────────────────────────────────────────────────────

# Google Gemini API 密钥（AI 对话功能）
GEMINI_API_KEY=your-gemini-api-key

# 文件上传目录（默认 ./uploads）
# UPLOAD_DIR=./uploads

# ── 服务器 ──────────────────────────────────────────────────

# 监听地址（阿里云部署改为 0.0.0.0）
# HOST=0.0.0.0
# PORT=3000

# 日志级别（生产建议 info）
# RUST_LOG=backend=info,tower_http=info
